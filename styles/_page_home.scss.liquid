// Home
// ======================================
main.home {
  height: 100%;

  background-image: url("//assets.mojocrowe.com/adhoc_images/mojo-blurred.png");
  background-repeat: no-repeat;
  //background-attachment: fixed;
  background-position: center;
  background-size: auto 125px;

  display: flex;
  justify-content: center;
  align-items: center;

  .cta {
    height: 50%;
    min-height: 250px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;

    h1 {
      text-align: center;
      font-family: $secondary-heading__font-family !important;
      font-weight: $secondary-heading__font-weight;
      font-size: $secondary-heading__font-size;
      letter-spacing: $secondary-heading__letter-spacing;
    }
  }
}
