// Student dashboard styling
.kapow-spa {
  background-color: $body__background-color;
}

// Card headings
.kapow-spa .kapow-card-content .card-heading a {
  text-transform: uppercase;
  font-family:
    "Avantt", "Arial Black", "Helvetica Neue", Arial, sans-serif !important;
  letter-spacing: -3%;
  font-weight: 900 !important;
  font-size: 15px;
}

// Card description
.kapow-spa .kapow-card-content p.card-description {
  font-family:
    "PPNeueMontreal", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  letter-spacing: 3%;
  font-weight: 400 !important;
  font-size: 12px;
}

.kapow-spa .fw-bold {
  font-weight: 900 !important;
}

.kapow-spt .fw-bold {
  font-weight: 900 !important;
}

// Learning pathway header
div.kapow-spt div.main-section h1.content-text {
  text-transform: uppercase;
  font-family:
    "Avantt", "Arial Black", "Helvetica Neue", Arial, sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: -3%;
  font-size: 40px;
}

.kapow-spt h4.content-text.leading-7 {
  text-transform: uppercase;
  font-family:
    "Avantt", "Arial Black", "Helvetica Neue", Arial, sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: -3%;
  font-size: 24px !important;
}

.kapow-spt p,
.kapow-spt div.col-md-6.col-sm-12 {
  font-family:
    "PPNeueMontreal", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-weight: 400;
  letter-spacing: 3%;
  font-size: 16px !important;
}

.kapow-spt h2 {
  font-family:
    "PPNeueMontreal", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 16px !important;
  font-weight: 400;
  letter-spacing: 3%;
}

//Hide the earn your certificate panel
.kapow-spt .main-section {
  section:last-child {
    // This is the last module above the certificate.
    // We need to remove the last dotted journey line.
    .container {
      & > div:nth-last-child(2) {
        & > div:first-child {
          & > div:last-child {
            border: none !important;
          }
        }
      }
      // This is the certificate message panel to be removed
      & > div:last-child {
        display: none !important;
      }
    }
  }
}

// "View course" links
.kapow-spt a[href*="/courses/take/"] {
  color: #2222ee;
  text-decoration: underline;
}

// Page banners
.banner__wrapper {
  .section__heading {
    margin-bottom: 0;
  }
}

.sign-in-page {
  background-color: #ffffff;
}

.button-primary {
  border-radius: 0;
  background-color: rgba(34, 34, 238, 1);
  box-shadow: 4px 4px rgba(119, 221, 153, 1);
  padding: 0.625rem 1.25rem;
  text-transform: uppercase;
  font-family:
    "Avantt", "Arial Black", "Helvetica Neue", Arial, sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: -3%;
  text-decoration: none !important;
  color: #fff !important;
  text-align: center;
  width: fit-content;
  height: fit-content;
}

.button-primary:hover {
  background-color: rgba(119, 221, 153, 1);
  box-shadow: 4px 4px rgba(34, 34, 238, 1);
}

.admin-notice__spacer,
.admin-notice__button {
  display: none;
}
