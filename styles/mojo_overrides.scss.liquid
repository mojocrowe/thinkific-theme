// Course player
#courses #player-wrapper > div > nav {
  display: none;
}

#courses #main-content {
  padding: 0;
}

#courses .course-player__content-header {
  display: none;
}

#courses .content-surface {
  background: #ffffff;
}

//Hide the earn your certificate panel
.kapow-spt .main-section {
  section:last-child {
    // This is the last module above the certificate.
    // We need to remove the last dotted journey line.
    .container {
      & > div:nth-last-child(2) {
        & > div:first-child {
          & > div:last-child {
            border: none !important;
          }
        }
      }
      // This is the certificate message panel to be removed
      & > div:last-child {
        display: none !important;
      }
    }
  }
}

// Brand styles are shared with the marketing site; platform-specific layout
// behaviour above is retained for the existing learning experience.

// Preserve the existing embedded-site admin notice behaviour.
.admin-notice__spacer,
.admin-notice__button {
  display: none;
}
